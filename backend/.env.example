PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/plantpanda?retryWrites=true&w=majority

# Redis connection (Redis Cloud / local)
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
COOKIE_NAME=pp_token

# CORS - comma separated origins allowed to hit the API
CLIENT_ORIGIN=http://localhost:5173,http://localhost:8081

# Google Maps (used server-side for distance matrix calculation)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# OpenRouteService (used for real road-following turn-by-turn routes on live tracking maps)
ORS_API_KEY=your_openrouteservice_api_key

# Dispatch tuning
DISPATCH_INITIAL_RADIUS_KM=5
DISPATCH_EXPANDED_RADIUS_KM=8
DISPATCH_ESCALATION_SECONDS=180

# COD rules (global, per business plan requirements)
COD_BLOCK_THRESHOLD=5000

# Default platform pricing (superadmin can edit at runtime via PlatformConfig doc)
DEFAULT_PER_KM_RATE=20
DEFAULT_BASE_FEE=20
DEFAULT_COMMISSION_RATE=10
